底 2–5 歲人口"},{"indicator":"居家托育人員數（附表）","level":"全國、縣市","first_year":2013,"last_year":2024,"note":"2015、2016 年制度斷點"},{"indicator":"平均每戶可支配所得","level":"全國、縣市","first_year":1998,"last_year":2025,"note":"主計總處家庭收支調查；金門縣、連江縣無資料"},{"indicator":"所得中位數（綜稅）","level":"鄉鎮市區","first_year":2012,"last_year":2023,"note":"財政部綜稅，每納稅單位"},{"indicator":"人口推估（高、中、低）","level":"全國","first_year":2025,"last_year":2070,"note":"國發會 2025 年版；2025 年為起點"},{"indicator":"因素關聯（模型）","level":"縣市","first_year":2011,"last_year":2025,"note":"因素取前一年，縣市與年份固定效果"},{"indicator":"因素關聯（含托育模型）","level":"縣市","first_year":2017,"last_year":2025,"note":"主模型變項加 0–2 歲托育使用率與幼兒園就讀率"}],"validation":{"asfr_max_abs_diff":0.571,"tfr_max_abs_diff":13.02,"district_tfr_max_abs_diff":11.38,"checked_cells":3560,"district_checked":593,"tolerances":{"asfr_abs":1.0,"county_tfr_abs":20,"district_tfr_abs":30},"marital":{"marital_rel_diff_max":0.2363,"marital_abs_diff_max":4.27,"checked":255,"years":[1975,2025]},"decomposition_max_residual":5.820766091346741e-11,"sums":{"county_population_sum":{"checked":156,"max_abs_diff":0.0},"township_population_sum":{"checked":836,"max_abs_diff":0.0},"county_births_vs_national":{"checked":19,"max_abs_diff":0.0},"single_age_vs_age_group":{"checked":437,"max_abs_diff":0.0},"township_births_vs_county":{"checked":418,"max_abs_diff":0.0},"parity_vs_township_births":{"checked":2942,"max_abs_diff":0.0}},"parity_source_gaps":[{"code":"64000050","year":2019,"births_vital":2096.0},{"code":"64000120","year":2019,"births_vital":2737.0}],"crosswalk":{"stem":22440,"skip":248,"alias":12},"childcare_sums":{"infant_centres":{"checked":11,"max_abs_diff":0.0},"infant_children":{"checked":11,"max_abs_diff":0.0},"childminders":{"checked":12,"max_abs_diff":0.0},"childminder_children":{"checked":12,"max_abs_diff":0.0}},"childcare_warnings":[{"code":"10005","year":2024,"field":"kindergarten_rate","value":1.0191},{"code":"10005","year":2025,"field":"kindergarten_rate","value":1.0298}],"projection":{"base":{"scenario":"medium","year":2025,"women15_49":5255829.0,"ris":5255829.0,"diff":0.0},"births":{"max_rel_diff":-0.029672,"scenario":"high","year":2025,"tolerance":0.03,"after_base":{"max_rel_diff":-0.018742,"scenario":"low","year":2035}},"decomposition_max_residual":2.091837814077735e-11}},"parameters":{"pool_years":3,"small_births":20,"small_women":1000,"gate":{"asfr_abs":1.0,"county_tfr_abs":20,"district_tfr_abs":30,"district_min_women":2000,"marital_rel":0.03,"marital_abs":2.0},"trend_periods":{"national":[[1975,1985],[1985,2000],[2000,2010],[2010,2015],[2015,2020],[2020,2025]],"county":[[2007,2015],[2015,2020],[2020,2025]],"district":[[2010,2015],[2015,2020],[2020,2025]],"zodiac_notes":{"2010":"虎年","2012":"龍年","2024":"龍年"}},"zodiac_notes":{"2010":"虎年","2012":"龍年","2024":"龍年"},"model_variables":["first_marriage_rate_f","first_marriage_age_f","college_share","income_disposable","social_increase","density","aged_share","sex_ratio_25_39"],"childcare_model_variables":["formal_care_rate_0_2","kindergarten_rate"],"childcare":{"under3_ages":[0,1,2],"preschool_ages":[2,3,4,5],"childminder_first_year":2016},"projection":{"scenarios":["high","medium","low"],"base_year":2025,"base_scenario":"medium","births_tolerance":0.03,"decomposition_ends":[2030,2035,2050,2070],"capacity_base_year":2024},"district_model_variables":["income_median","density","aged_share","sex_ratio_25_39","marriage_rate"],"model_lag":1,"vif_max":10,"latest_year":2025},"factors_summary":{"panel_rows":38798,"variables":17,"between":396,"within":24,"models":{"model":{"n":300,"clusters":20,"years":[2011,2025],"skipped":null,"dropped":[]},"model_childcare":{"n":180,"clusters":20,"years":[2017,2025],"skipped":null,"dropped":[]}},"district_model_n":368},"limitations":["所有數字都是戶籍登記統計（年度數字按發生日期），地區依戶籍歸屬，不一定是實際居住地；未設籍的外籍人士不在其中。","年中育齡女性以相鄰兩年年底人數平均估算。官方總生育率是把四捨五入後的整數年齡別生育率相加，本站使用未四捨五入的自算值，與官方值的差距列在資料說明頁。","2010 年底以前的臺北縣、桃園縣，以及臺中、臺南、高雄的縣與市，都已對應到現行縣市：人數相加、比率重算；合併前沒有共同口徑的平均年齡留空。","鄉鎮市區人數少，單年比率波動大；預設呈現三年合併的值，並標示年出生數少於 20 人或育齡女性少於 1,000 人的地區。","2019 年的胎次檔把高雄市三民區、鳳山區記為 0 人（與鄉鎮市區出生數不符），本站將這兩區當年視為缺漏，不補值。","出生數分解是人口會計恆等式：三個部分加總恰等於實際變化，但不能把「年齡別生育率」一項解讀為意願、政策成敗或任何原因。","有偶比例與有偶婦女生育率的分解只做全國：縣市沒有各年齡有偶人口的歷年公開表。有偶婦女生育率的分子包含非婚生嬰兒，與官方口徑相同。","因素頁呈現地區層級的描述性關聯：可能來自共同原因、反向關係或人口組成差異，不代表因果，也不能推論到個別家庭（生態謬誤）。縣市只有 22 個，叢集穩健區間較寬，請同時看逐一剔除縣市的範圍。","縣市所得為主計總處家庭收支調查的平均每戶可支配所得（抽樣調查，小縣市誤差較大；金門縣、連江縣不在調查範圍）。鄉鎮市區所得為綜合所得稅申報的「每納稅單位」所得中位數，只有 2012–2023 年，2018 年起股利可分開計稅，各年口徑不完全一致。教育程度為 15 歲以上兩性合計。","托育使用率的分子是在托嬰中心或登記居家托育人員處收托的幼兒，不含親屬照顧與未登記的保母；分母是戶籍 0–2 歲人口，跨縣市就托會讓個別縣市偏高或偏低。居家托育 2016 年改為登記制，人數與收托數在 2015、2016 年之間不能比較。幼兒園就讀率以學年度幼生數除以同年年底 2–5 歲人口，幼生可能含 6 歲，屬近似值。","人口推估是國發會在特定生育、死亡與遷移假設下的情境，不是預測。本站以推估表本身的年齡別生育率與女性人數重建出生數，與國發會公布值的差距列在資料說明頁；推估期間各年的分解與托育名額都只是機械式情境。","本版未納入房價負擔與女性勞動參與，也沒有縣市層級的人口推估，留待後續版本。"],"reading_guide":[{"term":"出生人數、粗出生率、總生育率","guide":"三者回答不同問題。出生人數是總量；粗出生率除以全部人口，會受高齡化影響；總生育率是「假設一位女性一生都照當年各年齡的生育率生育」的合成指標，不是現在的女性已經生了幾個孩子。"},{"term":"第二胎出生占比","guide":"是當年出生嬰兒的胎次結構，不是「生過第一胎的人再生第二胎的機率」。第一胎變少時，第二胎占比也可能上升。"},{"term":"初婚年齡與生第一胎年齡","guide":"兩者是不同的人群（當年初婚的人、當年生第一胎的母親），只並列比較，不能相減當成個人婚後等多久才生。"},{"term":"鄉鎮市區的比率","guide":"人數少的地區，一年多或少幾個嬰兒就會讓比率大幅跳動。預設看三年合併的值，並同時看原始出生數。"},{"term":"按發生與按登記","guide":"本站年度數字按出生發生日期統計；新聞常引用的月報多按登記日期，兩者不可直接混比，當年最後幾個月的數字也可能尚未完整。"},{"term":"出生數分解","guide":"把出生數的變化拆成育齡女性人數、年齡結構、年齡別生育率三部分，三者相加等於實際變化。這是會計拆解，不是原因分析。"},{"term":"跨縣市與縣市內","guide":"跨縣市相關比較的是同一年不同的地方；縣市內（雙向固定效果）比較的是同一縣市在不同年份的高低。兩者可能方向相反。"},{"term":"托育使用率","guide":"0–2 歲幼兒中，在托嬰中心或登記居家托育人員處被收托的比例。托育多的地方生育率較高，也可能是因為孩子多的地方設了更多托育；兩者的關聯不代表托育提高了生育。"},{"term":"推估情境","guide":"國發會的高、中、低推估是三組不同的生育率假設，不是三種可能性的機率。中推估不等於「最可能」，三者之間也不是誤差範圍。"},{"term":"推估出生數分解","guide":"把推估出生數的變化拆成育齡女性人數、年齡結構與推估生育率三部分。前兩項由已經出生的世代決定，即使生育率回升也很難改變。"},{"term":"關聯與原因","guide":"散布圖、相關係數與模型係數描述的是地區之間的共同變動，可能來自其他共同因素或反向關係，不是一個因素造成另一個的證據。"}]}